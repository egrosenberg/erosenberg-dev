<!DOCTYPE html>

<head>
    <link rel="stylesheet" type="text/css" href="/css/style.css">
    {{> "./templates/parts/js-includes.hbs"}}
    {{> "./templates/parts/favicon.hbs"}}
    <title>Ethan Rosenberg</title>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Ethan Rosenberg" />
    <meta name="twitter:description" content="Digital Portfolio" />
    <meta property="og:url" content="https://erosenberg.dev/" />
    <meta property="og:image" content="https://erosenberg.dev/img/card.webp" />
    <meta property="twitter:image" content="https://erosenberg.dev/img/card.webp" />
</head>

<body>
    <div class="display">
        <div class="relative-container">
            <div class="vc">
                <div class="top">
                    <a href="/" class="name-stacked large" href="">
                        <div class="title">
                            Ethan
                        </div>
                        <div class="subtitle">
                            Rosenberg
                        </div>
                    </a>
                </div>
                <div class="main">
                    <div class="left">
                        <nav class="navigation">
                            <a data-name="about" {{{ifThen (eq page "about") "class='active'"}}}>About</a>
                            <a data-name="projects" {{{ifThen (eq page "projects") "class='active'"}}}>Projects</a>
                        </nav>
                    </div>
                    <div class="content">
                        <div class="halftone-container-outer">
                            <div class="halftone-container">
                                <div class="halftone-control"><i class="fa-solid fa-pause"></i></div>
                                <div class="halftone"></div>
                            </div>
                        </div>
                        <div id="description" {{{ifThen content "" "style='display:none'"}}}>
                            {{#if content}}
                            {{{ content }}}
                            {{/if}}
                        </div>
                    </div>
                    <div class="right">
                        <div id="list">
                            {{#if right}}
                            {{{ right }}}
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>